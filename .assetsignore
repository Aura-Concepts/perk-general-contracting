# Files that live in the repo but are NOT part of the public website.
# Wrangler skips these when uploading static assets (gitignore-style patterns).
# This keeps source photos, build tooling, and docs off the live site.

# Photo source + build tooling (used only to regenerate the site's images)
site-photos/
build_site.py
rebuild.command

# Source copy for generated content — reviews.txt is baked into the HTML by
# build_site.py, so the raw file doesn't need to ship
content/

# Docs / notes
*.md
UPDATING-PHOTOS.md

# Repo / config plumbing
.git
.gitignore
.assetsignore
wrangler.toml
.claude/

# macOS junk (only reachable on a local `wrangler deploy`; git ignores it)
.DS_Store
**/.DS_Store
