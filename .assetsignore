# Files that live in the repo but are NOT part of the public website.
# Wrangler skips these when uploading static assets (gitignore-style patterns).
# This keeps source photos, build tooling, and docs off the live site.

# Photo source + build tooling (used only to regenerate the site's images)
site-photos/
build_site.py
rebuild.command

# Docs / notes
*.md
UPDATING-PHOTOS.md

# Repo / config plumbing
.git
.gitignore
.assetsignore
wrangler.toml
